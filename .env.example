# Switches on the real platform: accounts, listings, requirements, matching,
# messaging and the admin panel. Without these two set, /app, /admin, /login,
# /signup and /browse show a plain "not connected yet" message instead of
# crashing, and the founding network / contact forms simulate success locally.
#
# See supabase/README.md for the ten-minute setup (create a free project,
# run supabase/migrations/0001_init.sql, copy these two values from
# Project Settings -> API).
#
# VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# VITE_SUPABASE_ANON_KEY=eyJ...

# Optional, and only used when the two variables above are NOT set. When
# present, the founding network and contact forms POST their JSON payload to
# this URL instead of simulating a submission locally. Point it at your own
# endpoint or a hosted form service.
#
# VITE_ENQUIRY_ENDPOINT=https://example.invalid/api/enquiries
